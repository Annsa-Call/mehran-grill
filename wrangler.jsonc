{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mehran-grill",
  "workers_dev": true,
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mehran-grill",
      "database_id": "c3a8ed34-fcdf-46bf-8044-3c4ba0279270",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_MODE": "demo",
    "MESSAGING_MODE": "manual",
    "AUTOMATION_ENABLED": "false",
    "META_GRAPH_VERSION": "v23.0"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
